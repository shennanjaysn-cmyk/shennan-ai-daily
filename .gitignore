# 钉钉推送（含凭据，已隔离，禁止入库）
archive/dingtalk-push/

# Python
__pycache__/
*.pyc
.venv/
envs/

# 本地环境变量
.env
.env.*

# 构建产物：部署走 gh-pages，源码仓库只保留生成脚本与文档
# 用 dist/* 而非 /dist/，便于对静态资源做白名单放行（父目录不被整体排除）
dist/*
/dist-preview/
/archive/
ai-daily-*.html

# 例外：静态资源（字体/logo）需入库，供 GitHub Actions 构建与 gh-pages 部署
!dist/fonts/
!dist/fonts/**
!dist/fonts.css
!dist/logo.png

# 临时验证产物（headless 浏览器 profile / 诊断脚本输出）——禁止入库
# 教训（2026-08-31）：`git add -A` 会把 headless Chrome/Edge 的 --user-data-dir
# 整目录（Cache / Local Storage / Session Storage，含登录态）卷进 commit，
# 推到公开仓库即隐私泄露。凡 _ 开头的临时目录一律忽略。
_*_profile/
_*_temp/
_verify_tmp/
_diag*/
_shot*/
_real*/
_occl*/
_stack*/
_dim*/
_verify*/

# WorkBuddy 本地运行数据
.workbuddy/

# 版本归档：本地留存每一版 HTML（入库，供本地验证与历史追溯）
# 覆盖上方 ai-daily-*.html 的忽略规则，仅对 releases/ 放行
!releases/
!releases/ai-daily-*.html
